* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    user-select: none;
    -webkit-user-select: none;
}

body, html {
    width: 100%;
    height: 100%;
    overflow: hidden;
    background-color: #0b0f19;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}

#game-container {
    position: relative;
    width: 100%;
    height: 100%;
    max-width: 600px;
    margin: 0 auto;
    background: #000;
    overflow: hidden;
}

canvas {
    display: block;
    width: 100%;
    height: 100%;
}

#ui-layer {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
}

#hud {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 15px;
    font-size: 16px;
    font-weight: bold;
    color: #fff;
    text-shadow: 0 2px 4px rgba(0,0,0,0.8);
    pointer-events: auto;
}

.hud-item {
    background: rgba(0, 0, 0, 0.4);
    padding: 6px 12px;
    border-radius: 20px;
    backdrop-filter: blur(5px);
    border: 1px solid rgba(255, 255, 255, 0.2);
}

#pause-btn {
    background: rgba(0, 0, 0, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.3);
    color: white;
    font-size: 16px;
    padding: 6px 10px;
    border-radius: 50%;
    cursor: pointer;
}

.screen {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(5, 8, 15, 0.85);
    backdrop-filter: blur(8px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    pointer-events: auto;
    z-index: 10;
    transition: opacity 0.3s ease;
}

.hidden {
    display: none !important;
}

.glow-title {
    font-size: 2.5rem;
    color: #00ffcc;
    text-align: center;
    text-shadow: 0 0 15px rgba(0, 255, 204, 0.6), 0 0 30px rgba(0, 255, 204, 0.3);
    margin-bottom: 5px;
    letter-spacing: 2px;
}

.subtitle {
    color: #a0aec0;
    font-size: 1rem;
    margin-bottom: 30px;
}

.game-over-title {
    font-size: 3rem;
    color: #ff3366;
    text-shadow: 0 0 20px rgba(255, 51, 102, 0.6);
    margin-bottom: 20px;
}

.score-card {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 20px;
    border-radius: 12px;
    text-align: center;
    color: #fff;
    font-size: 1.2rem;
    margin-bottom: 30px;
    width: 80%;
    max-width: 300px;
}

.score-card p {
    margin: 8px 0;
}

.btn {
    padding: 14px 35px;
    font-size: 1.2rem;
    font-weight: bold;
    border: none;
    border-radius: 30px;
    cursor: pointer;
    box-shadow: 0 4px 15px rgba(0,0,0,0.3);
    transition: transform 0.1s ease, filter 0.2s ease;
}

.btn:active {
    transform: scale(0.95);
}

.primary-btn {
    background: linear-gradient(135deg, #00ffcc, #00b386);
    color: #000;
}

.secondary-btn {
    background: linear-gradient(135deg, #ff3366, #cc0033);
    color: #fff;
    margin-top: 15px;
}

.instructions {
    margin-top: 40px;
    text-align: center;
    color: #cbd5e0;
    font-size: 0.9rem;
    line-height: 1.6;
}
